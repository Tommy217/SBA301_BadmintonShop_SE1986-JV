# Base URL that httpClient calls
VITE_API_URL=/api
# true: use the mock API in mock/ ; false: proxy /api to the Spring Boot backend
VITE_USE_MOCK=true
# Catalog always uses Java. Other modules follow VITE_USE_MOCK.
# Spring Boot backend address for the Vite Catalog proxy (and all APIs when mock=false)
VITE_BACKEND_URL=http://localhost:8080
